# All the Much Bake Shop - Environment Variables
# Copy this file to .env.production on your Pi and fill in the actual values
# NEVER commit .env.production to Git!

# ====================
# Application Settings
# ====================

# Node environment (production for Pi)
NODE_ENV=production

# Port the Next.js app runs on
PORT=3000

# Public URL where the site is accessible
# This should be your domain name
NEXT_PUBLIC_SITE_URL=https://allthemuchbakeshop.com

# ====================
# Email Configuration
# ====================

# Resend API key for sending emails
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email address to send emails FROM
EMAIL_FROM=katie@allthemuchbakeshop.com

# Email address where order notifications should be sent
# This is Katie's email address
CONTACT_EMAIL=krgundel@gmail.com

# Katie's phone number for SMS notifications (via email-to-SMS gateway)
# Format: 10-digit phone number
# Will be used with carrier's email-to-SMS gateway
CONTACT_PHONE=7326911835

# Carrier for SMS gateway (att, verizon, tmobile, sprint)
# Used to construct email-to-SMS address
CONTACT_CARRIER=googlefi

# ====================
# Cloudflare Tunnel
# ====================

# Cloudflare Tunnel token
# Get this from: https://dash.cloudflare.com/
# Used by the cloudflared container to establish the tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ====================
# Backup Configuration
# ====================

# Google Drive configuration (for rclone backups)
# These will be set up when you run the rclone config
RCLONE_CONFIG_PATH=/app/rclone.conf

# Backup retention days (backups older than this are deleted)
BACKUP_RETENTION_DAYS=30

# ====================
# Stripe Payment Configuration
# ====================

# Stripe Secret Key (server-side)
# Get this from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (client-side)
# Get this from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ====================
# Security
# ====================

# Secret key for session encryption (if needed later)
# Generate with: openssl rand -base64 32
# SECRET_KEY=your_secret_key_here

# ====================
# Database Configuration
# ====================

# PostgreSQL connection (for Docker)
POSTGRES_USER=bakeshop
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bakeshop

# Prisma Database URL
# For local development with Docker: use localhost
# For app running inside Docker: use postgres (service name)
DATABASE_URL="postgresql://bakeshop:your_secure_password_here@localhost:5432/bakeshop"

# ====================
# Optional: Development Settings
# ====================

# Set to true to prevent emails from actually sending in development
# EMAIL_DEBUG=true

# Set to true to see verbose logging
# DEBUG=false
