// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  uom         String
  sku         String   @unique
  photos      String[]

  orderItems  OrderItem[]
  dropProducts DropProduct[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Drop {
  id          String   @id @default(cuid())
  name        String   
  slug        String   @unique
  dropOpens     DateTime
  pickupDate  DateTime
  deliveryDates DateTime[]
  pickupLocation String
  cutoffDate  DateTime
  isActive    Boolean  @default(true)
  maxCookies  Int
  currentCookies Int   @default(0)

  orders      Order[]
  emails      Email[]
  dropProducts DropProduct[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([cutoffDate])
}

model DropProduct {
  dropId      String
  drop        Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  isActive    Boolean  @default(true)
  maxQuantity Int?     // Max quantity available for this product in this drop (null = unlimited)
  displayOrder Int?    // For ordering products in drop display

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([dropId, productId])
  @@index([dropId])
  @@index([productId])
}

enum fulfillmentType {
  pickup
  delivery
}

enum OrderType {
  individual
  business
  group
}

enum Status {
  pending   // default
  rejected  // rejected by admin
  confirmed // accepted
  paid      // accepted and paid
  fulfilled // completed
  cancelled // cancelled by user or admin
  refunded  // refunded to user
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String
  street       String?
  city         String?
  state        String?
  zipCode      String
  businessName String?
  isBusiness   Boolean  @default(false)

  orders       Order[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Order {
  id              Int      @id @default(autoincrement())
  dropId          String
  drop            Drop     @relation(fields: [dropId], references: [id])
  orderType       OrderType
  attribution     String?

  customerId String?  @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  email      String   // Required for all orders (including guest orders)

  // Delivery address (for delivery orders)
  deliveryStreet String?
  deliveryCity   String?
  deliveryState  String?
  deliveryZip    String?

  orderItems   OrderItem[]
  payments     Payment[]
  totalAmount  Decimal  @db.Decimal(10, 2)
  fulfillmentType fulfillmentType
  requestedDate   DateTime?
  status          Status   @default(pending)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dropId])
  @@index([email])
  @@index([attribution])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  cancelled
  refunded
}

enum PaymentMethod {
  card
  cash
  check
  venmo
  other
}

model Payment {
  id              String        @id @default(cuid())
  orderId         Int
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(pending)
  paymentMethod   PaymentMethod

  // Payment processor details (Stripe, etc.)
  paymentIntentId String?       @unique
  transactionId   String?

  // Refund tracking
  refundedAmount  Decimal?      @db.Decimal(10, 2)
  refundedAt      DateTime?

  metadata        Json?         // For additional payment processor data

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([paymentIntentId])
  @@index([status])
}

model Email {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?

  // Which drop they signed up during (nullable)
  dropId       String?
  drop         Drop?    @relation(fields: [dropId], references: [id])

  isSubscribed Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dropId])
  @@index([isSubscribed])
}